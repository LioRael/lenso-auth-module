{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["credential"],
  "properties": {
    "credential": {
      "$ref": "#/$defs/Nullable_AuthenticateRequestCredential"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "AuthenticateRequestCredential": {
      "type": "object",
      "required": ["scheme", "value"],
      "properties": {
        "scheme": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "x-lenso-sensitive": true
        }
      },
      "additionalProperties": false
    },
    "Nullable_AuthenticateRequestCredential": {
      "anyOf": [
        {
          "$ref": "#/$defs/AuthenticateRequestCredential"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "AuthenticateRequest"
}
