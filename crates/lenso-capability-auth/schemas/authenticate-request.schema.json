{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["credential"],
  "properties": {
    "credential": {
      "type": ["object", "null"],
      "required": ["scheme", "value"],
      "properties": {
        "scheme": {
          "type": "string"
        },
        "value": {
          "type": "string",
          "x-lenso-sensitive": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
