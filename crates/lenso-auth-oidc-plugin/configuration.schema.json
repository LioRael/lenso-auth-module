{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "database_url_secret", "signing_key_secret", "code_pepper_secret",
    "issuer", "jwks", "client_id", "redirect_uris", "authorize_callers", "audience",
    "code_ttl_seconds", "token_ttl_seconds"
  ],
  "properties": {
    "schema": { "type": "string" },
    "database_url_secret": { "type": "string" },
    "signing_key_secret": { "type": "string" },
    "code_pepper_secret": { "type": "string" },
    "issuer": { "type": "string" },
    "jwks": {},
    "key_id": { "type": "string" },
    "client_id": { "type": "string" },
    "redirect_uris": { "type": "array", "items": { "type": "string" } },
    "authorize_callers": { "type": "array", "items": { "type": "string" } },
    "audience": { "type": "array", "items": { "type": "string" } },
    "code_ttl_seconds": { "type": "integer" },
    "token_ttl_seconds": { "type": "integer" }
  }
}
