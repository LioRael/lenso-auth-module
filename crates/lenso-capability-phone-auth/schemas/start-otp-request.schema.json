{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["phone", "purpose", "client_ip"],
  "properties": {
    "phone": {
      "type": "string",
      "x-lenso-sensitive": true
    },
    "purpose": {
      "$ref": "#/$defs/StartOtpRequestPurpose"
    },
    "client_ip": {
      "$ref": "#/$defs/Nullable_string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Nullable_string": {
      "type": ["string", "null"]
    },
    "StartOtpRequestPurpose": {
      "enum": ["login", "register"]
    }
  },
  "title": "StartOtpRequest"
}
