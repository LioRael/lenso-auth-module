{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["devices"],
  "properties": {
    "devices": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "device_id",
          "trusted",
          "primary",
          "last_seen_ip",
          "last_seen_user_agent",
          "updated_at"
        ],
        "properties": {
          "device_id": {
            "type": "string"
          },
          "trusted": {
            "type": "boolean"
          },
          "primary": {
            "type": "boolean"
          },
          "last_seen_ip": {
            "type": ["string", "null"]
          },
          "last_seen_user_agent": {
            "type": ["string", "null"]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
