{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["subject", "status", "reason", "disabled_until"],
  "properties": {
    "subject": {
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/SetSubjectStatusRequestStatus"
    },
    "reason": {
      "$ref": "#/$defs/Nullable_string"
    },
    "disabled_until": {
      "format": "date-time",
      "$ref": "#/$defs/Nullable_string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "Nullable_string": {
      "type": ["string", "null"]
    },
    "SetSubjectStatusRequestStatus": {
      "enum": ["active", "disabled"]
    }
  },
  "title": "SetSubjectStatusRequest"
}
