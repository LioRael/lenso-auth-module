{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["subjects", "next_cursor"],
  "properties": {
    "subjects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["subject", "status", "disabled_reason", "disabled_until", "created_at"],
        "properties": {
          "subject": {
            "type": "string"
          },
          "status": {
            "enum": ["active", "disabled"]
          },
          "disabled_reason": {
            "type": ["string", "null"]
          },
          "disabled_until": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "additionalProperties": false
      }
    },
    "next_cursor": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
