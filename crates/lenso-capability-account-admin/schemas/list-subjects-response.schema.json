{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["subjects", "next_cursor"],
  "properties": {
    "subjects": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/ListSubjectsResponseSubjectsItem"
      }
    },
    "next_cursor": {
      "$ref": "#/$defs/Nullable_string"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "ListSubjectsResponseSubjectsItem": {
      "type": "object",
      "required": ["subject", "status", "disabled_reason", "disabled_until", "created_at"],
      "properties": {
        "subject": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/ListSubjectsResponseSubjectsItemStatus"
        },
        "disabled_reason": {
          "$ref": "#/$defs/Nullable_string"
        },
        "disabled_until": {
          "format": "date-time",
          "$ref": "#/$defs/Nullable_string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "ListSubjectsResponseSubjectsItemStatus": {
      "enum": ["active", "disabled"]
    },
    "Nullable_string": {
      "type": ["string", "null"]
    }
  },
  "title": "ListSubjectsResponse"
}
