{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "Automerge in-range Lenso patch lockfile updates",
      "matchPackageNames": ["/^lenso(?:-|$)/"],
      "matchUpdateTypes": ["patch"],
      "rangeStrategy": "update-lockfile",
      "groupName": "lenso internal patch dependencies",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Review Lenso manifest and range changes",
      "matchPackageNames": ["/^lenso(?:-|$)/"],
      "matchUpdateTypes": ["minor", "major"],
      "groupName": "lenso internal manifest dependencies",
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
