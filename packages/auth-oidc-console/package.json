{
  "name": "@lenso/auth-oidc-console",
  "version": "0.0.0",
  "description": "Auth OIDC Console UI ESM artifact for the owning auth-oidc Module Release.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "files": ["dist", "console-module.json", "package.json"],
  "scripts": { "build": "vite build", "test": "vitest run src" },
  "exports": {
    ".": "./dist/index.js",
    "./artifact": "./dist/",
    "./manifest": "./console-module.json"
  },
  "lenso": {
    "console": {
      "artifact": "./dist/",
      "format": "console_ui_esm",
      "entry": "index.js",
      "manifest": "./console-module.json",
      "styleAssets": ["assets/stylex.css"]
    }
  },
  "dependencies": {
    "@lenso/auth-console-shared": "workspace:*",
    "@lenso/auth-provider-console-ui": "workspace:*",
    "@lenso/console-module-api": "^1.0.0",
    "@lenso/console-ui": "^1.0.2",
    "react": "^19.2.8"
  }
}
