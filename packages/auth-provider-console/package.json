{
  "name": "@lenso/auth-provider-console",
  "version": "0.1.1",
  "description": "Isolated Console UI artifact for Lenso auth provider modules.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LioRael/lenso-auth-module.git",
    "directory": "packages/auth-provider-console"
  },
  "homepage": "https://github.com/LioRael/lenso-auth-module#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "console-surface.json",
    "package.json"
  ],
  "scripts": {
    "build": "vite build",
    "prepack": "pnpm build"
  },
  "exports": {
    ".": "./dist/index.html",
    "./artifact": "./dist/",
    "./console-surface": "./console-surface.json"
  },
  "lenso": {
    "console": {
      "artifact": "./dist/",
      "bridgeProtocol": "lenso.console-bridge.v1",
      "surface": "./console-surface.json"
    }
  },
  "dependencies": {
    "@lenso/auth-console-ui-client": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  }
}
